# Skopiuj do .env i uzupelnij:  cp .env.example .env
# Srodowisko deweloperskie - przed wdrozeniem na produkcje zmien wszystkie hasla i sekrety!

DB_NAME=vitesse
DB_USER=vts_wp
DB_PASSWORD=zmien_mnie
DB_ROOT_PASSWORD=zmien_mnie_tez

WP_PORT=8090
PMA_PORT=8091
WP_DEBUG=true

# Sekrety aplikacji - NIGDY w wp_options (opcje wyciekaja w eksportach bazy i backupach).
# Wygeneruj: openssl rand -hex 32
VTS_TOKEN_SECRET=
VTS_LEAD_SALT=

# Skrzynki leadowe
VTS_LEAD_INBOX=biuro@vitesse.auto.pl
VTS_LEAD_INBOX_FLEET=

# Faza 5 - agent AI. Pusty = funkcja wylaczona.
VTS_OPENAI_API_KEY=

# Konto administratora WordPressa (tylko dev)
WP_ADMIN_USER=vtsadmin
WP_ADMIN_PASSWORD=

# Konto obslugi hamowni (tylko dev)
VTS_OPERATOR_USER=krzysiek
VTS_OPERATOR_PASSWORD=
